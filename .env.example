# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Microsoft Graph API (Azure AD App Registration)
GRAPH_TENANT_ID=<your-tenant-id>
GRAPH_CLIENT_ID=<your-client-id>
GRAPH_CLIENT_SECRET=<your-client-secret>
# Scope for client credentials flow (application permissions)
GRAPH_SCOPE=https://graph.microsoft.com/.default

# Power Automate webhook (optional — set to post flow payloads to a real PA HTTP trigger)
POWER_AUTOMATE_WEBHOOK_URL=

# MCP server (optional, all have safe defaults)
MCP_ALLOWED_DIR=sample_documents
MCP_MAX_FILE_MB=10
MCP_MAX_TEXT_CHARS=20000
MCP_AUDIT_LOG=logs/mcp_audit.log
MCP_GRAPH_USER_ID=
MCP_ENABLE_SEND_EMAIL=false
MCP_EMAIL_ALLOWED_DOMAINS=
AZURE_OPENAI_TIMEOUT_SECONDS=30
AZURE_OPENAI_MAX_RETRIES=2
